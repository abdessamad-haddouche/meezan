# Copy this file to .env and fill in real values. Never commit .env.

# DeepSeek API (LLM provider — Section 7/9 of docs/FRD.md)
DEEPSEEK_API_KEY=

# Reddit adapter (PRAW script app — Section 8)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=meezan/0.1 by <your-reddit-username>

# Meta Ad Library adapter (Section 8)
META_ACCESS_TOKEN=

# SERP fallback adapter (optional — Section 8)
# SERP_PROVIDER selects which API SERP_API_KEY is for: "serper" (default) or "serpapi"
SERP_PROVIDER=serper
SERP_API_KEY=

# Comma-separated adapter labels to skip entirely for every niche in a
# sweep (sweep_engine.py) — not called, not retried, just absent, same as
# if each always returned "unavailable". Use this for sources you haven't
# gotten working credentials for yet, so a sweep doesn't waste time
# attempting (and retrying) calls that can only fail.
# Valid labels: reddit, google_trends, meta_ads, serp, etsy, worldbank
# Example: DISABLED_ADAPTERS=meta_ads,etsy
DISABLED_ADAPTERS=
